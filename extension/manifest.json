{
  "manifest_version": 3,
  "name": "JevedIn: Cut the Slop from LinkedIn",
  "short_name": "JevedIn",
  "version": "1.2.1",
  "description": "Color-codes every LinkedIn post as engagement bait, humblebrag, AI slop or your own categories, so you can skip the noise.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://jev-backend.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "settings.js",
        "parse.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JevedIn",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-jevedin": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Turn JevedIn on or off"
    }
  },
  "homepage_url": "https://github.com/akshatnerella/jevedin"
}
